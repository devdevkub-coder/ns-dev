# Supabase SIT project database for local development/testing.
# Do not point local development at Production.
DATABASE_URL=postgresql://postgres.vbjlkxbytccklhqvxjuu:replace-with-sit-db-password@replace-with-sit-pooler-host:5432/postgres

# Supabase SIT frontend client
NEXT_PUBLIC_SUPABASE_URL=https://vbjlkxbytccklhqvxjuu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-sit-anon-key
VITE_SUPABASE_URL=https://vbjlkxbytccklhqvxjuu.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-sit-anon-key
VITE_AUTH_BYPASS=false

# Server-only Supabase admin key for invite/admin auth operations.
# Keep the real value only in local env or Vercel env. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-sit-service-role-key

# Server-only Upstash Redis configuration for public auth rate limits.
# The forgot-password endpoint fails closed when any of these values are absent or Redis is unavailable.
KV_REST_API_URL=https://replace-with-upstash-endpoint.upstash.io
KV_REST_API_TOKEN=replace-with-upstash-token
AUTH_RATE_LIMIT_SECRET=replace-with-a-long-random-server-only-secret

# Public app URL used in links inside LINE Flex messages.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# LINE Messaging API integration for WTI/WTO notifications.
# Get these from LINE Developers > Messaging API channel.
LINE_CHANNEL_ACCESS_TOKEN=replace-with-line-channel-access-token
LINE_CHANNEL_SECRET=replace-with-line-channel-secret
LINE_DEFAULT_TARGET_ID=replace-with-line-group-or-user-id

# Supabase Storage bucket for generated weight-ticket PDFs.
WEIGHT_TICKET_PDF_BUCKET=weight-ticket-pdfs

# Supabase SIT database connection for local DB tooling.
# Do not put real credentials in this example file.
SUPABASE_DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.vbjlkxbytccklhqvxjuu
SUPABASE_DB_PASSWORD=replace-with-sit-db-password
SUPABASE_DB_URL=postgresql://postgres.vbjlkxbytccklhqvxjuu:replace-with-sit-db-password@replace-with-sit-pooler-host:5432/postgres

# Local development login prefill only.
# Do not commit real passwords.
DEV_LOGIN_IDENTIFIER=replace-with-dev-login-email
DEV_LOGIN_PASSWORD=replace-with-dev-login-password

# Temporary test-login prefill for hosted demos.
# WARNING: NEXT_PUBLIC values are visible in browser output. Remove before real UAT/production use.
NEXT_PUBLIC_ENABLE_TEST_LOGIN_PREFILL=0
NEXT_PUBLIC_TEST_LOGIN_IDENTIFIER=replace-with-test-login-email
NEXT_PUBLIC_TEST_LOGIN_PASSWORD=replace-with-test-login-password
NEXT_PUBLIC_REFERENCE_CACHE_OBSERVABILITY=false
NEXT_PUBLIC_IMAGE_DELIVERY_OBSERVABILITY=false
